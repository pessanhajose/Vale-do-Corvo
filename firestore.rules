rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function isMaster() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'master';
    }
    function validCharacter(name) {
      return name in ['Guerreiro', 'Mago', 'Ladino', 'Clérigo'];
    }
    function validPosition(data) {
      return data.map in ['overworld', 'dungeon']
        && data.x is int && data.x >= 0 && data.x < 50
        && data.y is int && data.y >= 0 && data.y < 40;
    }

    // Cadastro público pode criar apenas perfil de jogador.
    match /users/{uid} {
      allow read: if isSelf(uid) || isMaster();
      allow create: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['role', 'displayName', 'createdAt'])
        && request.resource.data.role == 'player';
      allow update: if isMaster()
        || (isSelf(uid)
          && request.resource.data.role == resource.data.role
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName']));
      allow delete: if isMaster();
    }

    // Estado global do mapa, posições de inimigos e configurações do mestre:
    // leitura e escrita apenas do mestre.
    match /sessions/{sessionId} {
      allow read, write: if isMaster();
    }

    // Cada jogador pode ler e atualizar apenas o próprio personagem.
    // O nome do personagem não pode ser alterado pelo próprio jogador depois do cadastro.
    match /players/{uid} {
      allow read: if isSelf(uid) || isMaster();
      allow create: if isMaster()
        || (isSelf(uid)
          && request.resource.data.keys().hasOnly(['uid', 'characterName', 'map', 'x', 'y', 'updatedAt'])
          && request.resource.data.keys().hasAll(['uid', 'characterName', 'map', 'x', 'y'])
          && request.resource.data.uid == request.auth.uid
          && validCharacter(request.resource.data.characterName)
          && validPosition(request.resource.data));
      allow update: if isMaster()
        || (isSelf(uid)
          && request.resource.data.keys().hasOnly(['uid', 'characterName', 'map', 'x', 'y', 'updatedAt'])
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.characterName == resource.data.characterName
          && validCharacter(request.resource.data.characterName)
          && validPosition(request.resource.data));
      allow delete: if isMaster();
    }

    // Exploração individual: cada jogador acessa somente seu próprio estado;
    // o mestre pode consultar e administrar todos.
    match /exploration/{uid} {
      allow read, create, update: if isSelf(uid) || isMaster();
      allow delete: if isMaster();
    }

    // O mestre publica apenas os elementos que cada personagem pode enxergar.
    // Jogadores não podem forjar sua lista de tokens visíveis nem suas descobertas.
    match /visibleTokens/{uid} {
      allow read: if isSelf(uid) || isMaster();
      allow write: if isMaster();
    }
    match /discoveries/{uid} {
      allow read: if isSelf(uid) || isMaster();
      allow write: if isMaster();
    }

    // Segredos, tesouros, pistas e notas secretas do mestre.
    match /treasures/{treasureId} {
      allow read, write: if isMaster();
    }
    match /gmNotes/{noteId} {
      allow read, write: if isMaster();
    }

    // Negar qualquer coleção não prevista por padrão.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}